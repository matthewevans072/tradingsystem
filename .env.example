# Signal Desk configuration. Copy to .env (the launcher does this on first run).
# This file is read only by the local server. Keys are never sent to the
# browser, written to logs or stored in the database. Never commit .env.

# ---- Server ----
# Loopback only by default. Do not change unless you have read START-HERE.md "Remote access".
SIGNAL_DESK_HOST=127.0.0.1
SIGNAL_DESK_PORT=4317
# SIGNAL_DESK_DATA_DIR=data
# SIGNAL_DESK_SCHEDULER=true
# Required only if SIGNAL_DESK_ALLOW_REMOTE=true (at least 24 random characters):
# SIGNAL_DESK_ALLOW_REMOTE=false
# SIGNAL_DESK_ACCESS_TOKEN=

# ---- Market data (pick one) ----
# twelvedata | finnhub | none
MARKET_DATA_PROVIDER=none
TWELVEDATA_API_KEY=
FINNHUB_API_KEY=

# ---- News & filings ----
# Finnhub key above also enables company news and the earnings calendar.
# SEC EDGAR is free but requires a contact email in the request header:
SEC_CONTACT_EMAIL=

# ---- Anthropic API: "Ask Signal Desk" chat + optional briefing analyst ----
# Get a key at https://console.anthropic.com (API keys). Usage is billed per
# token to this key; it is separate from any Claude subscription, and building
# the app with Claude Code does not give the app model access.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5        # briefing narratives / news analysis
# CHAT_BACKEND=anthropic                 # anthropic | disabled
# CHAT_MODEL=claude-opus-5-5             # e.g. claude-sonnet-5-5 for lower cost
# CHAT_EFFORT=high                       # low | medium | high | xhigh | max
# CHAT_DAILY_BUDGET_USD=5                # stop chat spending after this estimate per day (0 = no cap)
# CHAT_MAX_TOOL_ROUNDS=8
# CHAT_PRICE_INPUT=                      # US$ per million input tokens, only for a model Signal Desk has no price for
# CHAT_PRICE_OUTPUT=                     # US$ per million output tokens (same)

# ---- Delivery (optional) ----
# Email via SMTP. Gmail: smtp.gmail.com, port 465, and an App Password (not your normal password).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=
# Phone push via ntfy (https://ntfy.sh). Use a long, unguessable topic name.
NTFY_URL=
NTFY_TOKEN=

# ---- Strategy Lab (simulation only; see strategy/LAB-ARCHITECTURE.md) ----
# A signal in the simulated forward test is acted on only if its bar is
# processed within this many minutes of the bar's close (default 5).
# LAB_MAX_SIGNAL_DELAY_MIN=5
# Optional TradingView alert receiver. Off unless BOTH are set. It listens on
# 127.0.0.1 only and accepts POST /tradingview; TradingView can reach it only
# through a tunnel or reverse proxy you set up yourself (forward that one path
# only). Alerts are journalled and compared with Signal Desk's own signals;
# they never trade and never drive the simulated account. The secret (at least
# 24 random characters) goes in the Pine script's "Webhook secret" input; it is
# never stored or logged. Use a port different from SIGNAL_DESK_PORT.
# LAB_WEBHOOK_SECRET=
# LAB_WEBHOOK_PORT=4318
#
# Optional history source for the Strategy Lab: a free Alpaca market-data
# account (https://alpaca.markets). Used ONLY to download split-adjusted,
# consolidated (SIP) 15-minute bars for the backtest history
# (GET data.alpaca.markets/v2/stocks/bars, adjustment=split, feed=sip). No
# trading API is called and no order can be placed. Keys stay in this file;
# they are never sent to the browser, logged or stored in a database. The free
# plan serves SIP data only once it is more than 15 minutes old, so it cannot
# feed the forward test. Licensed for personal, non-commercial use only. See
# strategy/DATA-READINESS.md.
# ALPACA_API_KEY_ID=
# ALPACA_API_SECRET_KEY=
# Which source "Download history" uses by default: auto (Alpaca when its keys
# are set, otherwise MARKET_DATA_PROVIDER) | alpaca | twelvedata
# LAB_HISTORY_SOURCE=auto
