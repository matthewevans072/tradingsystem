# Signal Desk configuration. Copy to .env (the launcher does this on first run).
# This file is read only by the local server. Keys are never sent to the
# browser, written to logs or stored in the database. Never commit .env.

# ---- Server ----
# Loopback only by default. Do not change unless you have read START-HERE.md "Remote access".
SIGNAL_DESK_HOST=127.0.0.1
SIGNAL_DESK_PORT=4317
# SIGNAL_DESK_DATA_DIR=data
# SIGNAL_DESK_SCHEDULER=true
# Required only if SIGNAL_DESK_ALLOW_REMOTE=true (at least 24 random characters):
# SIGNAL_DESK_ALLOW_REMOTE=false
# SIGNAL_DESK_ACCESS_TOKEN=

# ---- Market data (pick one) ----
# twelvedata | finnhub | none
MARKET_DATA_PROVIDER=none
TWELVEDATA_API_KEY=
FINNHUB_API_KEY=

# ---- News & filings ----
# Finnhub key above also enables company news and the earnings calendar.
# SEC EDGAR is free but requires a contact email in the request header:
SEC_CONTACT_EMAIL=

# ---- Anthropic API: "Ask Signal Desk" chat + optional briefing analyst ----
# Get a key at https://console.anthropic.com (API keys). Usage is billed per
# token to this key; it is separate from any Claude subscription, and building
# the app with Claude Code does not give the app model access.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5        # briefing narratives / news analysis
# CHAT_BACKEND=anthropic                 # anthropic | disabled
# CHAT_MODEL=claude-opus-5-5             # e.g. claude-sonnet-5-5 for lower cost
# CHAT_EFFORT=high                       # low | medium | high | xhigh | max
# CHAT_DAILY_BUDGET_USD=5                # stop chat spending after this estimate per day (0 = no cap)
# CHAT_MAX_TOOL_ROUNDS=8

# ---- Delivery (optional) ----
# Email via SMTP. Gmail: smtp.gmail.com, port 465, and an App Password (not your normal password).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=
# Phone push via ntfy (https://ntfy.sh). Use a long, unguessable topic name.
NTFY_URL=
NTFY_TOKEN=
