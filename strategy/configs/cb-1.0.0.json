      "flattenMinutesBeforeClose": 15
    },
    "swing": {
      "maxHoldSessions": 10,
      "flattenMinutesBeforeCloseOnLastSession": 15
    }
  },
  "costs": {
    "accountCurrency": "USD",
    "commissionPerShare": 0.005,
    "commissionMinPerOrder": 1.0,
    "commissionMaxPctOfValue": 1.0,
    "halfSpreadBps": 2.0,
    "slippageBps": 2.0,
    "limitFillTicksBeyond": 1,
    "tickSize": 0.01,
    "fxConversionPct": 0.0,
