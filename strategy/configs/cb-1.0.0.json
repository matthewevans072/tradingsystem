  },
  "risk": {
    "hypotheticalStartingEquity": 100000,
    "riskPerTradePct": 0.25,
    "maxOpenRiskPct": 1.0,
    "maxPositions": 3,
    "allowMargin": false,
    "allowShort": false,
    "excludeLeveragedEtfs": true,
    "notes": "Testing assumptions only. They are not the owner's approved live risk limits. Gaps can make a loss larger than the planned risk."
