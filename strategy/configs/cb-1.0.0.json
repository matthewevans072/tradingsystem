  "createdAt": "2026-10-21",
  "bars": {
    "timeframeMinutes": 15,
    "session": "regular",
    "chartType": "standard candlesticks",
    "priceAdjustment": "split-adjusted, not dividend-adjusted",
    "direction": "long_only"
  },
  "box": {
    "lookbackBars": 20,
    "atrLength": 14,
    "maxHeightAtr": 3.0,
    "minHeightAtr": 0.0,
    "touchToleranceAtr": 0.2,
    "minTouchesEach": 2,
    "minBarsBetweenTouches": 2,
    "setupExpiryBars": 10,
    "invalidateOnCloseBelowSupport": true,
    "allowWindowAcrossSessions": true
  },
  "entry": {
    "volumeMultiple": 1.5,
    "volumeLookbackBars": 20,
    "maxGapAtr": 0.5,
    "minRewardRisk": 2.0,
    "orderType": "limit_at_next_open",
    "noNewEntriesMinutesBeforeClose": 60
  },
  "stop": {
    "atrBuffer": 0.1,
    "interpretation": "below the breakout candle's low (its lower wick) minus an ATR buffer; the source video's wick-based stop is ambiguous and this is the chosen reading",
    "maxCostToRiskPct": 20,
    "minStopAtr": 0.0
  },
  "target": {
    "boxHeightMultiple": 1.0
  },
  "management": {
    "trailingStop": false,
    "partialExits": false,
    "breakevenMove": false
  },
  "modes": {
