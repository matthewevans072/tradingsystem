{
  "name": "signal-desk",
  "version": "0.1.0",
  "private": true,
  "description": "Personal portfolio tracking and investment research desk (local, read-only, no trading).",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server/index.js",
    "dev": "node --disable-warning=ExperimentalWarning --watch server/index.js",
    "test": "node --disable-warning=ExperimentalWarning --test \"tests/*.test.js\"",
    "backup": "node --disable-warning=ExperimentalWarning scripts/backup.js",
    "briefing": "node --disable-warning=ExperimentalWarning scripts/run-briefing.js",
    "lab:backtest": "node --disable-warning=ExperimentalWarning scripts/strategy-backtest.js",
    "lab:compare-tv": "node --disable-warning=ExperimentalWarning scripts/strategy-compare-tv.js",
    "rt:planted": "node --disable-warning=ExperimentalWarning scripts/rangetrend-planted.mjs",
    "rt:run": "node --disable-warning=ExperimentalWarning scripts/rangetrend-run.mjs",
    "sb:download": "node --disable-warning=ExperimentalWarning scripts/sweepbos-download.mjs",
    "sb:planted": "node --disable-warning=ExperimentalWarning scripts/sweepbos-planted.mjs",
    "sb:run": "node --disable-warning=ExperimentalWarning scripts/sweepbos-run.mjs",
    "sb:report": "node --disable-warning=ExperimentalWarning scripts/sweepbos-report.mjs",
    "il:download": "node --disable-warning=ExperimentalWarning scripts/ictlab-download.mjs",
    "il:run": "node --disable-warning=ExperimentalWarning scripts/ictlab-run.mjs",
    "il:report": "node --disable-warning=ExperimentalWarning scripts/ictlab-report.mjs",
    "il:planted": "node --disable-warning=ExperimentalWarning scripts/ictlab-planted.mjs",
    "rr:worker": "node --disable-warning=ExperimentalWarning scripts/research-worker.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.137.0"
  }
}
